{
  "name": "bun-react-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/server/main.ts",
    "start": "NODE_ENV=production bun src/server/main.ts",
    "build": "bun run build.ts",
    "cli": "bun src/cli/index.ts",
    "test:mailbox": "bun run scripts/setup-test-mailbox.ts",
    "test": "bun test tests/unit tests/integration",
    "test:frontend": "bun test --preload ./tests/setup/happydom.ts tests/frontend",
    "test:all": "bun run test && bun run test:frontend",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.3.0",
    "dompurify": "^3.4.15",
    "imapflow": "^2.0.5",
    "lucide-react": "^0.545.0",
    "mailparser": "^3.9.28",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.0.10",
    "radix-ui": "^1.6.7",
    "react": "^19",
    "react-dom": "^19",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bun": "latest",
    "@types/dompurify": "^3.2.0",
    "@types/mailparser": "^3.4.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "happy-dom": "^20.14.5",
    "tailwindcss": "^4.1.11",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7"
  }
}
